# ============================================================================
# API Doctor — example configuration
#
#   cp .env.example .env        (Windows:  copy .env.example .env)
#
# Copying this file unchanged gives you a working local setup. Only
# OPENAI_API_KEY needs filling in, and even that is optional — see below.
#
# Every value here is the application default, so a commented-out or absent
# line behaves identically to the value shown. Real environment variables
# override this file, so you can change any of it per-shell without editing.
#
# .env is gitignored. This file is not: keep it free of real credentials.
# Loaded from the repo root, then backend/.env, by app/config/settings.py.
# ============================================================================


# ============================================================================
# 1. AI PROVIDER — OpenAI
#    The only section most people need to touch.
# ============================================================================

# Leave blank to run the deterministic rule engine instead. That engine is
# always labelled `deterministic-offline` in the API and the UI, and is never
# presented as model output — so a blank key is a supported mode, not a broken
# one. The full detect -> diagnose -> repair -> verify pipeline still runs.
#
# Verify after setting it:  curl http://127.0.0.1:8000/api/system/ai
# Expect: "ok": true, "active_engine": "openai"
#
# Never paste this key into a project you upload for repair. It is stripped
# from every sandboxed process and never sent to the frontend.
OPENAI_API_KEY=

# Model selection happens here and nowhere else — no model name is hard-coded
# at a call site. The client adapts its request parameters to the family:
# reasoning models (gpt-5*, o1/o3/o4) get `reasoning.effort` and no temperature,
# everything else (gpt-4o-mini and friends) gets `temperature` and no reasoning.
OPENAI_MODEL=gpt-4o-mini

# Compatible gateway or Azure-style endpoint. Blank = https://api.openai.com/v1
OPENAI_BASE_URL=

OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_MAX_RETRIES=2
# minimal | low | medium | high (ignored by models without a reasoning param)
OPENAI_REASONING_EFFORT=medium

# Ceiling on the agent's tool loop, so one repair cannot spin forever.
AGENT_MAX_TOOL_ITERATIONS=14
AGENT_MAX_TOOL_CALLS_PER_ITERATION=4

# Set false to disable the offline fallback entirely; the app will then error
# rather than diagnose when no key is configured.
ALLOW_OFFLINE_ENGINE=true


# ============================================================================
# 2. APPLICATION
# ============================================================================

APP_NAME=API Doctor

# `production` enables a startup safety check that REFUSES to boot on an unsafe
# configuration: open auth, EXECUTION_MODE=local, wildcard CORS, API keys under
# 24 characters, or multiple workers without REDIS_URL.
APP_ENV=development

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================================================
# 3. IDENTITY AND TENANCY
# ============================================================================

# user   — email + password accounts with emailed OTP verification. Each
#          account is its own tenant and sees only its own projects. Default.
# apikey — Authorization: Bearer <key>, for machine callers and CI. Each key
#          is an isolated tenant.
# open   — one shared tenant, unauthenticated. Local development only;
#          production refuses to start this way.
AUTH_MODE=user

# Signs OTP digests. MANDATORY when AUTH_MODE=user in production: without it
# every worker generates its own, so a code issued by one cannot be verified by
# another, and a restart invalidates every code in flight.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set false to freeze the user list on a private instance. Existing accounts
# keep working; new sign-ups are refused.
ALLOW_REGISTRATION=true

# Session cookie. The idle window slides while the user works; the absolute
# lifetime never extends, so a stolen cookie cannot be kept alive forever.
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_ABSOLUTE_LIFETIME_SECONDS=1209600
# MUST be true in production so the cookie never crosses plain HTTP. Leave
# false for http://localhost, where browsers reject Secure cookies.
SESSION_COOKIE_SECURE=false
# lax is right for a same-origin app. Use none (with Secure) only if the
# frontend is served from a different site than the API.
SESSION_COOKIE_SAMESITE=lax

# "key:tenant" pairs, or bare keys (tenant derived from a hash of the key).
# Use high-entropy values; production rejects anything under 24 characters.
#   API_KEYS=Zx9f2QpL7vT4mNc8RbW1yH6sKdE3aJgU:acme,7pQ2mZx9LvT4Nc8RbW1yH6sKdE3aJgU:globex
API_KEYS=

# Subset of API_KEYS granted administrative scope.
ADMIN_API_KEYS=


# ============================================================================
# 3b. ONE-TIME CODES  (email verification and password reset)
#     Stored in Redis as an HMAC, never in plaintext, and expired by TTL.
# ============================================================================

OTP_TTL_SECONDS=600
# Wrong guesses allowed before the code is burned and a new one is required.
OTP_MAX_ATTEMPTS=5
# Minimum wait between "resend code" requests.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# How long the user has to choose a new password after passing the reset code.
OTP_TICKET_TTL_SECONDS=900


# ============================================================================
# 3c. EMAIL  (delivers the one-time codes)
#     Any SMTP provider. Leave SMTP_HOST empty in development and codes are
#     written to the log instead of being sent; production refuses to start
#     that way when AUTH_MODE=user, because nobody could register.
# ============================================================================

# SendGrid (what this project is set up against):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_USERNAME=apikey          <- the literal word, identical for every
#                                    account; it is NOT your email address
#   SMTP_PASSWORD=SG.xxxxxxxx     <- the API key, needs "Mail Send" permission
#   SMTP_FROM_EMAIL=              <- must be verified under Sender Authentication,
#                                    or SendGrid rejects the send with a 550
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The From: address. Defaults to SMTP_USERNAME when empty — which is wrong for
# SendGrid, where the username is `apikey` rather than an address, so set it.
SMTP_FROM_EMAIL=
# STARTTLS on port 587 (usual). For implicit TLS on 465 set SSL true, TLS false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20


# ============================================================================
# 4. DATABASE — Neon (or any Postgres)
#    The system of record: users, projects, repair sessions, execution records.
#
#    Leave it empty and the app falls back to on-disk JSON stores, which is
#    fine on a laptop and wrong anywhere else — the data lives inside one
#    container's filesystem, so a second replica sees a different world and a
#    redeploy loses everything. Production refuses to start without it.
#
#    Project *workspaces* always stay on disk regardless: they are source trees
#    that pytest and Docker execute against, not rows.
# ============================================================================

# From the Neon console → Connection string. Use the "-pooler" host when you
# run more than one worker; Neon caps concurrent connections and the pooler
# endpoint fronts them with PgBouncer.
#   DATABASE_URL=postgresql://user:password@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/apidoctor?sslmode=require
# Any Postgres works too:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/apidoctor
DATABASE_URL=

# Keep the pool small: Neon's free tier allows few concurrent connections, and
# every query here is short.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

# How long the shared Redis cache holds a tenant's dashboard and history before
# recomputing. Writes invalidate it immediately across every worker, so this is
# a ceiling on staleness for changes made elsewhere, not on your own.
DB_CACHE_TTL_SECONDS=5


# ============================================================================
# 5. CACHE AND SHARED STATE  (Redis — required for more than one worker)
# ============================================================================

# Without this, each worker keeps private in-memory state. Two things then
# break silently: an approval POST that lands on the wrong worker never applies
# the patch, and SSE clients see no events from other workers.
#
#   docker run -d -p 6379:6379 redis:7-alpine
#   REDIS_URL=redis://127.0.0.1:6379/0
#
# Verify a real deployment: python backend/tests/check_multiworker.py
REDIS_URL=
STATE_NAMESPACE=apidoctor


# ============================================================================
# 6. EXECUTION SANDBOX
# ============================================================================

# auto   — prefer Docker, fall back to LOCAL TRUSTED MODE if the daemon is down
# docker — require the sandbox; refuse to start without a reachable daemon
# local  — LOCAL TRUSTED MODE: uploaded code runs on the host with NO isolation.
#          The UI banners this on every screen. Only for code you trust.
EXECUTION_MODE=auto

EXECUTION_TIMEOUT_SECONDS=180
DOCKER_IMAGE=python:3.12-slim
DOCKER_CPU_LIMIT=1.0
DOCKER_MEMORY_LIMIT=512m
DOCKER_PIDS_LIMIT=128
DOCKER_NETWORK=none
DOCKER_TMPFS_SIZE=128m
DOCKER_READ_ONLY_ROOTFS=true
API_PROBE_TIMEOUT_SECONDS=30
API_STARTUP_TIMEOUT_SECONDS=25


# ============================================================================
# 7. CAPACITY AND CONCURRENCY
#    See docs/scaling.md for measured numbers and how to size these.
# ============================================================================

# Heavy jobs start containers and run test suites. These are the real limits of
# the machine, not of the HTTP layer. Beyond them, callers get 202 with a job id
# or 429 with Retry-After — never an unbounded wait.
MAX_CONCURRENT_JOBS=4
MAX_CONCURRENT_JOBS_PER_TENANT=1
MAX_QUEUED_JOBS=200
MAX_QUEUED_JOBS_PER_TENANT=5
JOB_TIMEOUT_SECONDS=1800

# Blank = derived from CPU count (cpu: cores, io: 8x cores).
CPU_POOL_WORKERS=
IO_POOL_WORKERS=

# Time in-flight jobs get to finish on shutdown. Keep gunicorn's
# --graceful-timeout comfortably above this.
SHUTDOWN_DRAIN_SECONDS=30

# Read aggregates (dashboard, history, project list) are polled constantly and
# scan disk. A short TTL plus single-flight turns a thundering herd into one
# scan. 0 disables it.
AGGREGATE_CACHE_SECONDS=2.0


# ============================================================================
# 8. RATE LIMITS AND QUOTAS  (per tenant)
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=30
# Anything that starts a container or calls OpenAI.
RATE_LIMIT_HEAVY_PER_MINUTE=10
# Sign-in, registration and OTP. Bucketed per client IP, not per tenant: the
# caller has no tenant yet, and a shared bucket would let one attacker lock
# every other user out of signing in.
RATE_LIMIT_AUTH_PER_MINUTE=10

MAX_PROJECTS_PER_TENANT=25
# 0 = unlimited. A storage cap would otherwise reinstate the size limit that
# MAX_PROJECT_SIZE_MB=0 removes.
MAX_STORAGE_PER_TENANT_MB=0

MAX_SSE_CLIENTS=1000
SSE_HEARTBEAT_SECONDS=15


# ============================================================================
# 9. UPLOAD LIMITS
#    Checked from the archive's central directory before a single byte is
#    extracted.
#
#    SIZE LIMITS ARE OFF BY DEFAULT. 0 means unlimited: a project of any size
#    can be imported. This is supportable because the upload path never holds a
#    whole archive in memory — the request body is streamed to a staging file
#    and members are extracted in 64 KB chunks, so peak memory is flat no matter
#    how large the project is.
#
#    Set a positive number to reimpose a ceiling. If you do, remember to raise
#    `client_max_body_size` in deploy/nginx.conf to match, or nginx will reject
#    the upload before the app ever sees it.
# ============================================================================

MAX_PROJECT_SIZE_MB=0
MAX_EXTRACTED_SIZE_MB=0
MAX_FILE_SIZE_MB=0

# NOT size limits, and deliberately still enforced:
#
#   MAX_FILE_COUNT       — millions of tiny entries exhaust inodes and stall the
#                          filesystem regardless of total bytes. .git,
#                          node_modules and .venv are skipped before counting.
#   MAX_COMPRESSION_RATIO — the zip-bomb guard. It catches an archive that is
#                          small on the wire but expands without bound, which no
#                          byte ceiling can detect ahead of time. Removing the
#                          size limits does NOT remove this protection.
MAX_FILE_COUNT=200000
MAX_COMPRESSION_RATIO=120


# ============================================================================
# 10. REPAIR POLICY
# ============================================================================

MAX_REPAIR_ATTEMPTS=3

# When true, no patch is ever written without an explicit developer decision.
# Set false only for CI or an unattended demo.
REQUIRE_APPROVAL=true

# Blast-radius caps. A root-cause fix should be small; these reject anything
# that is not, before it is shown to the developer.
MAX_PATCH_FILES=5
MAX_PATCH_EDITS=12
MAX_PATCH_LINES_CHANGED=120

# Pre-patch snapshots retained per project, for rollback.
KEEP_SNAPSHOTS=20


# ============================================================================
# 11. STORAGE
# ============================================================================

# Uploaded workspaces, snapshots, sessions and reports. Gitignored.
DATA_DIR=./data


# ============================================================================
# 12. FRONTEND
# ============================================================================

# Where Next.js proxies /api/* on the server side. In Docker Compose this is the
# service name (http://backend:8000), not localhost.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
