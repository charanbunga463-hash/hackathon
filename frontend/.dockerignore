# Build context exclusions for the frontend image.
#
# The context is this directory, so Docker only consults THIS file — the one at
# the repository root no longer applies.
#
# node_modules must be excluded even though the image needs dependencies: they
# are installed inside the image by `npm ci` against the lockfile. Copying a
# host node_modules would ship binaries built for the wrong platform.

# ---- secrets -------------------------------------------------------------
.env
.env.*
*.pem
*.key

# ---- node / next ---------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache
npm-debug.log*

# ---- editors / os --------------------------------------------------------
.DS_Store
Thumbs.db
